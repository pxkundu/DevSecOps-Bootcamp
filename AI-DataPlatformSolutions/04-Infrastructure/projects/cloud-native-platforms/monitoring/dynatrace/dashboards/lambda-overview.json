    {
      "name": "Invocations Over Time",
      "tileType": "DATA_EXPLORER",
      "configured": true,
      "bounds": {
        "top": 228,
        "left": 0,
        "width": 760,
        "height": 304
      },
      "customName": "Invocations Over Time",
      "queries": [
        {
          "id": "A",
          "spaceAggregation": "SUM",
          "timeAggregation": "DEFAULT",
          "splitBy": ["dt.entity.aws_lambda_function"],
          "metricSelector": "builtin:cloud.aws.lambda.invocations:splitBy(\"dt.entity.aws_lambda_function\"):sum:auto:sort(value(sum,descending)):limit(10)",
          "enabled": true
