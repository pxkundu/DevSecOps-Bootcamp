      "visualConfig": {
        "type": "GRAPH_CHART",
        "global": {
          "hideLegend": false
        },
        "axes": {
          "xAxis": { "visible": true },
          "yAxes": [{ "visible": true, "min": "AUTO", "max": "AUTO" }]
        }
