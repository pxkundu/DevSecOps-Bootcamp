{
  "metadata": {
    "configurationVersions": [7],
    "clusterVersion": "1.285.0"
  },
  "dashboardMetadata": {
    "name": "AWS Lambda - Serverless Overview",
    "shared": true,
    "owner": "platform-team",
    "dashboardFilter": {
      "timeframe": "-2h",
      "managementZone": null
    },
    "tags": ["aws", "lambda", "serverless", "monitoring"],
    "preset": false
  },
  "tiles": [
    {
      "name": "Dashboard Header",
      "tileType": "MARKDOWN",
      "configured": true,
      "bounds": {
        "top": 0,
        "left": 0,
        "width": 1520,
        "height": 76
      },
      "markdown": "## 🚀 AWS Lambda Serverless Monitoring\n\n**Purpose**: Monitor Lambda function performance, errors, and cold starts | **Contact**: Platform Team | [Runbook](https://wiki.example.com/lambda-runbook)"
    },
    {
      "name": "Total Invocations",
      "tileType": "DATA_EXPLORER",
      "configured": true,
      "bounds": {
        "top": 76,
        "left": 0,
        "width": 304,
        "height": 152
      },
      "customName": "Total Invocations",
      "queries": [
        {
          "id": "A",
          "spaceAggregation": "SUM",
          "timeAggregation": "DEFAULT",
          "splitBy": [],
          "metricSelector": "builtin:cloud.aws.lambda.invocations:splitBy():sum",
          "enabled": true
        }
      ],
      "visualConfig": {
        "type": "SINGLE_VALUE",
        "global": {
          "hideLegend": true
        },
        "thresholds": [
          {
            "axisTarget": "LEFT",
            "rules": [
              { "color": "#7dc540" }
            ],
            "visible": true
          }
        ]
      }
    },
    {
      "name": "Error Rate",
      "tileType": "DATA_EXPLORER",
      "configured": true,
      "bounds": {
        "top": 76,
        "left": 304,
        "width": 304,
        "height": 152
      },
      "customName": "Error Rate %",
      "queries": [
        {
          "id": "A",
          "spaceAggregation": "AUTO",
          "timeAggregation": "DEFAULT",
          "splitBy": [],
          "metricSelector": "(builtin:cloud.aws.lambda.errors:splitBy():sum / builtin:cloud.aws.lambda.invocations:splitBy():sum) * 100",
          "enabled": true
        }
      ],
      "visualConfig": {
        "type": "SINGLE_VALUE",
        "global": {
          "hideLegend": true
        },
        "thresholds": [
          {
            "axisTarget": "LEFT",
            "rules": [
              { "value": 0, "color": "#7dc540" },
              { "value": 1, "color": "#f5d30f" },
              { "value": 5, "color": "#dc172a" }
            ],
            "visible": true
          }
        ]
      }
    },
    {
      "name": "Cold Start Rate",
      "tileType": "DATA_EXPLORER",
      "configured": true,
      "bounds": {
        "top": 76,
        "left": 608,
        "width": 304,
        "height": 152
      },
      "customName": "Cold Start Rate %",
      "queries": [
        {
          "id": "A",
          "spaceAggregation": "AUTO",
          "timeAggregation": "DEFAULT",
          "splitBy": [],
          "metricSelector": "(builtin:cloud.aws.lambda.coldStarts:splitBy():sum / builtin:cloud.aws.lambda.invocations:splitBy():sum) * 100",
          "enabled": true
        }
      ],
      "visualConfig": {
        "type": "SINGLE_VALUE",
        "global": {
          "hideLegend": true
        },
        "thresholds": [
          {
            "axisTarget": "LEFT",
            "rules": [
              { "value": 0, "color": "#7dc540" },
              { "value": 20, "color": "#f5d30f" },
              { "value": 50, "color": "#dc172a" }
            ],
            "visible": true
          }
        ]
      }
    },
    {
