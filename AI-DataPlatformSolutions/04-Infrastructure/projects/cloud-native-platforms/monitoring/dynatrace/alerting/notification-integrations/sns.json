{
  "type": "AWS_SNS",
  "name": "AWS Serverless Alerts - SNS",
  "active": true,
  "alertingProfile": "REPLACE_WITH_ALERTING_PROFILE_ID",
  "topicArn": "arn:aws:sns:us-east-1:ACCOUNT_ID:dynatrace-serverless-alerts",
  "subject": "[{ProblemSeverity}] Dynatrace: {ProblemTitle}",
  "message": {
    "problemId": "{ProblemID}",
    "problemTitle": "{ProblemTitle}",
    "severity": "{ProblemSeverity}",
    "impact": "{ProblemImpact}",
    "state": "{State}",
    "rootCause": "{RootCauseEntity}",
    "affectedEntities": "{ImpactedEntities}",
    "url": "{ProblemURL}",
    "timestamp": "{ProblemStartTime}"
  }
}

