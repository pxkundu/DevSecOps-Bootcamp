{
  "name": "dynatrace-sample-serverless-app",
  "version": "1.0.0",
  "description": "Sample AWS Serverless application with Dynatrace monitoring",
  "main": "src/handlers/createOrder.js",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage production",
    "remove": "serverless remove",
    "logs:create": "serverless logs -f createOrder -t",
    "logs:process": "serverless logs -f processOrder -t",
    "test": "jest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-sqs": "^3.400.0",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "serverless": "^3.35.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Platform Team",
  "license": "MIT",
  "keywords": [
    "aws",
    "serverless",
    "lambda",
    "dynatrace",
    "monitoring",
    "observability"
  ]
}

